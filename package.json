{
  "name": "antigravityforjarvisassistant",
  "version": "1.0.0",
  "description": "JARVIS AI Assistant — Antigravity",
  "main": "jarvis.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx jarvis.ts",
    "dev:supervised": "tsx scripts/superviseJarvis.ts",
    "build": "tsc",
    "start": "node dist/jarvis.js",
    "clean": "rimraf dist",
    "test": "tsx tests/runAll.ts",
    "test:latency": "tsx tests/runAll.ts --only=latencySmokeTest",
    "test:voice-core": "tsc --noEmit && tsx tests/runAll.ts --only=nodeBridgeSingletonTest,voiceRouteMockTest,interruptGatingTest,openAppSmokeTest,latencySmokeTest,deterministicCommandRouteTest,noGroqForLocalCommandsTest,ttsLifecycleStateTest,stopClearsTtsQueueTest,noThinkMemoryTest,bargeInProcessingTest,voiceYouTubeIntegrationTest",
    "test:pc-control": "tsc --noEmit && tsx tests/runAll.ts --only=systemStateSmokeTest,chromeStateSmokeTest,systemStateRouteTest,permissionSessionTest,actionQueueRecoveryTest,rollbackManagerTest,closeAppRouteTest,pcControlKernelTest,appControlTest,windowControlTest,browserControlTest,inputControlTest,mouseKeyboardControlTest,fileControlSafetyTest,processControlSafetyTest,systemControlSafetyTest,adminControlTest",
    "test:all": "npm run test:voice-core && npm run test:pc-control",
    "test:ci": "tsx tests/runAll.ts --ci",
    "test:live": "tsx tests/runAll.ts --live --only=finalIntegrationSuiteTest,successfulExecutionLifecycleAuditTest",
    "typecheck": "tsc --noEmit",
    "verify:windows": "tsx scripts/verifyWindows.ts",
    "check:brain": "tsx scripts/checkBrain.ts",
    "backup": "tsx backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "axios": "^1.15.0",
    "dotenv": "^17.4.1",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.4",
    "ioredis": "^5.11.1",
    "lowdb": "^7.0.1",
    "neo4j-driver": "^6.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
