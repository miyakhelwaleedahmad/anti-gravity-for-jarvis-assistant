import * as fs from 'fs';

const data = JSON.parse(fs.readFileSync('analysis.json', 'utf8'));
const files = Object.keys(data).sort();

let agents: string[] = [], managers: string[] = [], services: string[] = [], engines: string[] = [], tools: string[] = [], memory: string[] = [];
let reasoning: string[] = [], planner: string[] = [], vision: string[] = [], voice: string[] = [], security: string[] = [];
let unused: string[] = [], partial: string[] = [], active: string[] = [];

files.forEach(f => {
  const d = data[f];
  const lower = f.toLowerCase();
  
  if (d.status === 'Unused') unused.push(f);
  else if (d.status === 'Partial') partial.push(f);
  else active.push(f);

  if (lower.includes('agent')) agents.push(f);
  if (lower.includes('manager')) managers.push(f);
  if (lower.includes('service')) services.push(f);
  if (lower.includes('engine')) engines.push(f);
  if (lower.includes('tool')) tools.push(f);
  if (lower.includes('memory') || lower.includes('database')) memory.push(f);
  if (lower.includes('reasoning')) reasoning.push(f);
  if (lower.includes('planner') || lower.includes('scheduler') || lower.includes('autonomy')) planner.push(f);
  if (lower.includes('vision') || lower.includes('perception')) vision.push(f);
  if (lower.includes('voice')) voice.push(f);
  if (lower.includes('security')) security.push(f);
});

let md = `Based on a recursive codebase audit of the workspace, here is the detailed architectural analysis of the JARVIS system.\n\n`;

md += `## Module Details\n\n`;

const folders: Record<string, string[]> = {};
files.forEach(f => {
  const folder = f.split('/')[0];
  if (!folders[folder]) folders[folder] = [];
  folders[folder].push(f);
});

for (const [folder, folderFiles] of Object.entries(folders)) {
  md += `### Subsystem: ${folder.toUpperCase()}\n`;
  folderFiles.forEach(f => {
    const d = data[f];
    const name = f.split('/').pop()?.replace(/\.(ts|js|py)$/, '') || '';
    const deps = d.imports.join(', ') || 'None';
    md += `- **Module Name**: ${name}\n`;
    md += `  - **Folder Location**: ${f}\n`;
    md += `  - **Status**: ${d.status}\n`;
    md += `  - **Complexity Score**: ${d.lines} lines, ${d.exports.length} exports\n`;
    md += `  - **Dependencies**: ${deps.substring(0, 100)}${deps.length > 100 ? '...' : ''}\n\n`;
  });
}

md += `\n# JARVIS SYSTEM MODULE INVENTORY\n\n`;
md += `- Total Architectural Modules: ${files.length}\n`;
md += `- Total Agents: ${agents.length}\n`;
md += `- Total Managers: ${managers.length}\n`;
md += `- Total Services: ${services.length}\n`;
md += `- Total Engines: ${engines.length}\n`;
md += `- Total Tools: ${tools.length}\n`;
md += `- Total Memory Components: ${memory.length}\n`;
md += `- Total Reasoning Components: ${reasoning.length}\n`;
md += `- Total Planning Components: ${planner.length}\n`;
md += `- Total Vision Components: ${vision.length}\n`;
md += `- Total Voice Components: ${voice.length}\n`;
md += `- Total Security Components: ${security.length}\n\n`;

md += `# COMPLETE MODULE TREE\n\n`;
md += \`\\\`\\\`\\\`text\nJARVIS_WORKSPACE/\n\`;
for (const [folder, folderFiles] of Object.entries(folders)) {
  md += \`├── \${folder}/\n\`;
  folderFiles.forEach((f, idx) => {
    const isLast = idx === folderFiles.length - 1;
    const name = f.split('/').pop();
    md += \`│   \${isLast ? '└──' : '├──'} \${name}\n\`;
  });
}
md += \`\\\`\\\`\\\`\n\n\`;

md += `# SYSTEM ARCHITECTURE MAP\n\n`;
md += \`\\\`\\\`\\\`text\n\`;
md += `+-------------------------------------------------------------+\n`;
md += `|                     JARVIS COGNITIVE OS                     |\n`;
md += `+-------------------------------------------------------------+\n`;
md += `         |                             |               |       \n`;
md += ` +---------------+             +---------------+ +-----------+ \n`;
md += ` | PERCEPTION    |             | CORE & BRIDGE | | EXECUTION | \n`;
md += ` | - Vision      |             | - Orchestrator| | - Tools   | \n`;
md += ` | - Voice       |             | - BrainLoop   | | - Sandbox | \n`;
md += ` +-------+-------+             +-------+-------+ +-----+-----+ \n`;
md += `         |                             |               |       \n`;
md += ` +-------v-------+             +-------v-------+ +-----v-----+ \n`;
md += ` | REASONING     |<===========>| MEMORY SYSTEM | | PLANNING  | \n`;
md += ` | - Agents      |             | - Redis       | | - Graph   | \n`;
md += ` | - Reflection  |             | - Graph/Neo4j | | - Tasks   | \n`;
md += ` +-------+-------+             +---------------+ +-----------+ \n`;
md += `         |                             |                       \n`;
md += ` +-------v-----------------------------v-------+               \n`;
md += ` |                SELF HEALING                 |               \n`;
md += ` |          (Pipeline Registry, Repair)        |               \n`;
md += ` +---------------------------------------------+               \n`;
md += \`\\\`\\\`\\\`\n\n\`;

md += `# CRITICAL CORE MODULES\n\n`;
const coreModules = files.filter(f => f.includes('orchestrator') || f.includes('brain') || f.includes('messageBus') || f.includes('systemController') || f.includes('memoryManager') || f.includes('agentStateMachine'));
coreModules.forEach(f => md += `- **${f}**\n`);

md += `\n# UNUSED OR REDUNDANT MODULES\n\n`;
if (unused.length === 0) {
  md += `No modules were explicitly marked as DEPRECATED or unused in the codebase. However, some stubbed components exist:\n`;
  partial.forEach(f => md += `- **${f}** (Partial / Stub)\n`);
} else {
  unused.forEach(f => md += `- **${f}** (Unused/Deprecated)\n`);
}

md += `\n# FINAL VERDICT\n\n`;
md += `- **Total Modules**: ${files.length}\n`;
md += `- **Fully Operational (Active)**: ${active.length}\n`;
md += `- **Incomplete (Partial/Stub)**: ${partial.length}\n`;
md += `- **Dead Code (Unused)**: ${unused.length}\n`;

fs.writeFileSync('report.md', md);
console.log('Report written to report.md');
