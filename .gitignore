ai_workflows/_config/github my persnal tokens.txt

# Generated/runtime artifacts

*.wav
analysis.json
tsc_output.txt
**stability_report**.json
logs/*.txt



# Local/runtime generated data
data/backups/
data/logs/
graphify-out/

# Local scratch files
tests/scratch.txt
Untitled.base
Untitled.canvas

# Obsidian local workspace metadata
.obsidian/
ai_workflows/_config/github my persnal tokens.txt
.env
.env.*

# Runtime security state (permission sessions) — created at runtime, never commit.
data/security/

# Atomic-write scratch files left behind by interrupted writes — never commit.
*.json.tmp
.*.json.tmp

# Persisted vector store — runtime data, never commit.
data/vector/*
!data/vector/.gitkeep

# Episodic memory log — runtime data, never commit.
data/episodes.jsonl
