.venv/
**pycache**/
*.py[cod]
*.pyo
*.egg-info/
dist/
*.log

# Node / TypeScript

node_modules/
dist/
*.js.map
*.d.ts.map

# Memory / DB files (optional — remove if you want to keep them)

memory/jarvis_memory.json
memory/reflections.json
memory/session_summaries.jsonl

# OS

.DS_Store
Thumbs.db

# Runtime and logs

data/runtime/*.json
logs/*.jsonl
logs/*.log

