.obsidian/
ai_workflows/_config/github my persnal tokens.txt
.env
.env.*

# Runtime security state (permission sessions) — created at runtime, never commit.
data/security/

# Atomic-write scratch files left behind by interrupted writes — never commit.
*.json.tmp
.*.json.tmp

# Persisted vector store — runtime data, never commit.
data/vector/*
!data/vector/.gitkeep

# Episodic memory log — runtime data, never commit.
data/episodes.jsonl

# Live runtime state — belongs to the machine, not the repository. A checkout
# must never overwrite the user's real goals, memory or task history.
data/goals.json
memory/taskHistory.json
memory/userMemory.json
environment/systemInfo.json

# Stale generated tree dumps (~42 MB of them were committed once).
project_structure.txt
project_tree.txt
jarvis_structure*.txt
fresh_structure*.txt
*-tree*.txt
folder_structure.txt
clean_structure.txt
tsc_output.txt
analysis.json
temp_stt_*.wav
*.ts.bak

# Ingested document manifest — runtime data.
data/rag/
