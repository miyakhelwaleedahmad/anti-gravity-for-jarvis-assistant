# Environment variables — NEVER commit real secrets!

# ─── Groq API (Primary LLM) ───────────────────────────────────────────────────

# Get your key at: https://console.groq.com

GROQ_API_KEY=

# Model for main reasoning

JARVIS_BRAIN_MODEL=qwen/qwen3-32b

# Model for fast lightweight tasks

JARVIS_FAST_MODEL=qwen/qwen3-32b

# Groq API base URL

GROQ_API_URL=https://api.groq.com/openai/v1

# ─── Runtime tuning for older local PCs ───────────────────────────────────────

JARVIS_LLM_TIMEOUT_MS=10000
JARVIS_PLANNING_WATCHDOG_MS=20000
JARVIS_MEMORY_WRITE_DEBOUNCE_MS=2000
JARVIS_ACTIVE_WINDOW_POLL_MS=4000
JARVIS_OPEN_APPS_POLL_MS=5000
JARVIS_CHROME_TABS_POLL_MS=7000
JARVIS_SERVICES_POLL_MS=15000
JARVIS_SYSTEM_STATS_POLL_MS=10000
JARVIS_SYSTEM_STATE_WRITE_MS=3000

# ─── xAI (Reflection Engine — optional) ──────────────────────────────────────

# Used by reflectionEngine.py for self-learning analysis

# Leave empty to use Groq for reflection instead

XAI_API_KEY=

# ─── Voice ────────────────────────────────────────────────────────────────────

TTS_VOICE=en-US-GuyNeural

# ─── Local Python Bridge ──────────────────────────────────────────────────────

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9000

# Required shared secret for local Python voice clients.

# Set your own strong secret in the real .env file.

JARVIS_BRIDGE_TOKEN=

# Set true ONLY if you explicitly want local insecure development without a token.

JARVIS_BRIDGE_DEV_MODE=false

# Full URI used by Python voice modules

BRIDGE_WS_URI=ws://127.0.0.1:9000
