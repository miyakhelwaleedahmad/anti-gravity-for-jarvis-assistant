# Environment variables — NEVER commit real secrets!

# ─── LLM provider ─────────────────────────────────────────────────────────────

# JARVIS uses Gemini or Groq through the same OpenAI-compatible client.
# Set the key of ONE provider; JARVIS picks the provider whose key is set.
# Set JARVIS_LLM_PROVIDER=gemini or groq only if both keys are present.

JARVIS_LLM_PROVIDER=

# ── Gemini (Google AI Studio key) ──

GEMINI_API_KEY=

# Optional. Defaults to the OpenAI-compatible endpoint below; the bare API root
# (https://generativelanguage.googleapis.com/v1beta) also works.

GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Groq (https://console.groq.com) ──

GROQ_API_KEY=

# GitHub search and repository lookups (tools/githubTools.ts). Optional: without
# a token GitHub allows about 10 searches a minute. A read-only token is enough;
# JARVIS writes nothing to GitHub. Never paste the token into a file JARVIS can
# read (SEC-14) — keep it here only.

# GITHUB_TOKEN=
GROQ_API_URL=https://api.groq.com/openai/v1

# ── Models (must belong to the provider above) ──
# Gemini: gemini-3.5-flash and gemini-3.5-flash-lite (each has its own
#         free-tier rate limit, so using both spreads the load)
# Groq:   e.g. qwen/qwen3-32b and llama-3.1-8b-instant

JARVIS_BRAIN_MODEL=
JARVIS_FAST_MODEL=

# Thinking before answering: none | minimal | low | medium | high | off.
# Default for Gemini is minimal: thinking is paid out of max_tokens, and higher
# levels cut short replies off. "off" stops JARVIS sending the setting at all.
# Leave empty for Groq unless your model supports reasoning_effort.

JARVIS_LLM_REASONING_EFFORT=

# ─── Fallback LLM provider (optional) ────────────────────────────────────────

# Any OpenAI-compatible chat-completions endpoint, tried when the primary
# provider fails. Without this, a Groq outage stops all reasoning. Leave the key
# empty and set only the base URL for a local server that needs no auth.

JARVIS_FALLBACK_BASE_URL=
JARVIS_FALLBACK_API_KEY=
JARVIS_FALLBACK_MODEL=

# ─── Model per kind of work (optional; bridge/modelCategories.ts) ─────────────

# Each kind of work uses the brain or fast model above unless set here:
#   <model>                same provider, another model
#   <provider>:<model>     e.g. anthropic:claude-opus-5-5
#   anthropic              Claude with its default model (claude-opus-5-5)
# Kinds: INTENT, CONVERSATION, PLANNING, REPAIR_PLAN, CODING, REVIEW.
# JARVIS_MODEL_CODING=
# JARVIS_MODEL_REVIEW=
# JARVIS_MODEL_CODING_TIMEOUT_MS=300000
# Price per million tokens, only to estimate cost where token counts are known:
# JARVIS_MODEL_PRICES={"claude-opus-5-5":{"input":4,"output":20}}

# ─── Claude (optional) ────────────────────────────────────────────────────────

# Used only by a kind of work that names "anthropic" above; never as a fallback
# for ordinary requests. The model is checked against your key's model list
# before its first use.
# ANTHROPIC_API_KEY=
# JARVIS_ANTHROPIC_EFFORT=high
# Server-side fallback when Claude declines a request (on by default):
# JARVIS_ANTHROPIC_FALLBACKS=off

# ─── Self-repair limits (optional) ────────────────────────────────────────────

# "heal yourself" and "propose a code repair": attempts per run, minutes per
# run, and the model-token cap for a code repair.
# JARVIS_REPAIR_MAX_ATTEMPTS=2
# JARVIS_REPAIR_MAX_MINUTES=20
# JARVIS_REPAIR_TOKEN_CAP=200000
# Mirror repair issues as notes into an Obsidian vault folder (off by default):
# JARVIS_OBSIDIAN_VAULT=

# ─── Workspace containment ────────────────────────────────────────────────────

# Absolute path to the JARVIS project root. This is the containment boundary for
# all agent file I/O (read_file / write_file / control_file / run_command cwd).
# Leave empty to derive it from the installed location, which is correct for a
# normal checkout. Set it explicitly only if the project is launched from a
# different directory than it lives in.

JARVIS_WORKSPACE_ROOT=

# ─── Permissions ──────────────────────────────────────────────────────────────
#
# What JARVIS may do without asking (docs/upgrade/PERMISSION_MODEL.md).
# 1 (default): reading the PC and low-risk actions (open an app or a web page,
# focus a window) run at once. 0: the previous default, where control_app and
# control_window need full control mode as well.
# JARVIS_DEFAULT_PERMISSION_LEVEL=1
#
# Actions of level 2 and above (type, click, close an app, write a file, end a
# process): session (default) = only while full control mode is on, and level 3
# and 4 are also asked each time; ask = JARVIS asks you to approve each one,
# with or without full control mode.
# JARVIS_LEVEL2_POLICY=session
#
# Highest risk level a spoken "yes" may approve (0-3, default 2). Above it the
# request must be approved by typing in the console; voice can still cancel.
# The microphone can pick up a video, a call or another person.
# JARVIS_VOICE_APPROVAL_MAX_RISK=2
#
# How long a typed approval waits for your answer, in seconds (10–120; default
# 30). No answer still denies the action. Three ways to give it 120 s:
#   - here in .env (every run):           JARVIS_APPROVAL_TIMEOUT_S=120
#   - CMD, this window only:              set JARVIS_APPROVAL_TIMEOUT_S=120
#   - PowerShell, this window only:       $env:JARVIS_APPROVAL_TIMEOUT_S = "120"
# In CMD, put no spaces around "=" and no quotes.
# JARVIS_APPROVAL_TIMEOUT_S=30
#
# Most times each tool may run per minute, at risk level 0,1,2,3,4 (0 = no limit).
# JARVIS_TOOL_RATE_LIMITS=120,60,20,10,10
#
# While you talk to JARVIS, background agents and goals wait this long (ms) at
# most before each model call, so your request gets the provider quota first.
# 0 = do not wait.
# JARVIS_BACKGROUND_YIELD_MS=20000
#
# The local Control Center: a page at http://127.0.0.1:7790 on this PC only.
# Log in with the token in data\security\control_center_token (made at the
# first start), or set your own below. Actions use the same permission checks
# as a spoken request; turning on full control is still approved in the console.
# JARVIS_CONTROL_CENTER=1
# JARVIS_CONTROL_CENTER_PORT=7790
# JARVIS_CONTROL_CENTER_TOKEN=

# ─── Development awareness ────────────────────────────────────────────────────
#
# Local ports "is my backend running?" checks (127.0.0.1 only).
# JARVIS_DEV_PORTS=3000,3001,4200,5000,5173,8000,8080,8081,8888
#
# Folders whose git repositories JARVIS may read (;-separated; it looks at each
# folder and one level below). Default: the JARVIS folder.
# JARVIS_PROJECT_DIRS=C:\Users\you\code;D:\work
#
# How long a test/build script may run, and how long a dev server has to
# answer on its port (milliseconds).
# JARVIS_DEV_RUN_TIMEOUT_MS=600000
# JARVIS_DEV_SERVER_START_MS=30000

# ─── Browser ──────────────────────────────────────────────────────────────────
#
# The DevTools port of the Chrome JARVIS reads (127.0.0.1 only). Start that
# Chrome with the same port and a profile of its own:
#   start chrome.exe --remote-debugging-port=9222 --user-data-dir="%USERPROFILE%\jarvis-chrome-profile"
# JARVIS_CDP_PORT=9222
#
# Where browser downloads go (an absolute path). Default: Downloads\jarvis in
# your user folder. Downloaded files are never opened by JARVIS.
# JARVIS_DOWNLOAD_DIR=C:\Users\you\Downloads\jarvis

# ─── Runtime tuning for older local PCs ───────────────────────────────────────

JARVIS_LLM_TIMEOUT_MS=10000
# Leave empty: planning then waits for every retry of a model request (3 × the timeout above + 2 s).
JARVIS_PLANNING_WATCHDOG_MS=
JARVIS_MEMORY_WRITE_DEBOUNCE_MS=2000
JARVIS_ACTIVE_WINDOW_POLL_MS=4000
JARVIS_OPEN_APPS_POLL_MS=5000
JARVIS_CHROME_TABS_POLL_MS=7000
JARVIS_SERVICES_POLL_MS=15000
JARVIS_SYSTEM_STATS_POLL_MS=10000
JARVIS_SYSTEM_STATE_WRITE_MS=3000

# A command heard while JARVIS is busy waits at most this long (ms) before it
# is skipped; JARVIS says when it skips one.
# JARVIS_QUEUED_COMMAND_MAX_AGE_MS=30000

# Seconds after a reply in which a follow-up needs no wake word (0 = off).
# JARVIS_FOLLOWUP_SECONDS=15

# off = do not start the screen-capture (Vision) service. Nothing switches it
# on yet, so on a low-memory PC it only holds memory.
# JARVIS_VISION=off

# ─── Vector memory model download (optional) ─────────────────────────────────

# The embedding model is downloaded from Hugging Face once, then loaded from the
# local cache. A free read token (huggingface.co/settings/tokens) lifts the
# anonymous rate limit on that first download.

# HF_TOKEN=

# ─── Vector memory persistence ────────────────────────────────────────────────

# Where the vector store is written. Defaults to <project>/data/vector.

JARVIS_VECTOR_STORE_DIR=

# Set false to run the vector store in RAM only (previous behaviour).

JARVIS_VECTOR_PERSIST=true

# Flush the store to disk after this many accepted writes.

JARVIS_VECTOR_PERSIST_EVERY=10

# The vector service (127.0.0.1:8000) answers only requests carrying this token.
# Leave empty: JARVIS makes one and keeps it in data/security/vector_token, which
# the service reads too. Set it only if you start vectorMemory.py yourself with
# a different data folder.

JARVIS_VECTOR_TOKEN=

# Cap on how many facts are re-embedded when no persisted store is found.
# Empty or 0 means all of them. (This used to be hard-coded to 10.)

JARVIS_VECTOR_REBUILD_LIMIT=

# Minimum gap in ms between two calls to the same tool.

JARVIS_MIN_TOOL_GAP_MS=250

# ─── xAI ──────────────────────────────────────────────────────────────────────

# Not used by JARVIS: no code calls xAI. Kept only so older .env files still
# parse. It does not count as an LLM key.

XAI_API_KEY=

# ─── Graph memory (Neo4j — optional, off by default) ─────────────────────────

# Master switch. Graph memory stays disabled unless this is exactly "true".

JARVIS_NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Required when JARVIS_NEO4J_ENABLED=true. There is no default: the driver
# refuses to connect without it rather than trying a well-known password.

NEO4J_PASSWORD=

# ─── Voice ────────────────────────────────────────────────────────────────────

TTS_VOICE=en-US-GuyNeural

# Wake-word log detail: INFO (default) or DEBUG.

JARVIS_WAKEWORD_LOG_LEVEL=

# ─── Local Python Bridge ──────────────────────────────────────────────────────

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9000

# Required shared secret for local Python voice clients.

# Set your own strong secret in the real .env file.

JARVIS_BRIDGE_TOKEN=

# Set true ONLY if you explicitly want local insecure development without a token.
# Dev mode skips the token only: a web page (any browser Origin) is refused in
# every mode, so it can never send commands or answer approvals.

JARVIS_BRIDGE_DEV_MODE=false

# Browser origins allowed to connect to the bridge, comma-separated and exact
# (e.g. http://127.0.0.1:5555). Leave empty: JARVIS's own clients send none.

JARVIS_BRIDGE_ALLOWED_ORIGINS=

# Largest message a bridge client may send, in MB (default 16; vision frames are the largest).

JARVIS_BRIDGE_MAX_PAYLOAD_MB=

# Full URI used by Python voice modules

BRIDGE_WS_URI=ws://127.0.0.1:9000

# ─── Slow PC or slow connection (all optional) ───────────────────────────────

# Time budget for one tool call by its risk, in ms (defaults 30000 / 20000 / 15000).
# When it runs out the tool's process and everything it started are stopped,
# the call ends as a timeout, and it is not retried.

JARVIS_TOOL_BUDGET_LOW_MS=
JARVIS_TOOL_BUDGET_MEDIUM_MS=
JARVIS_TOOL_BUDGET_HIGH_MS=

# How long a stopped tool gets to end before JARVIS stops waiting for it (default 5000).

JARVIS_TOOL_STOP_GRACE_MS=

# One LLM request may take this long before it is cancelled (default 10000).

# JARVIS_LLM_TIMEOUT_MS=20000

# Planning gives up after this long. Default: 3 × JARVIS_LLM_TIMEOUT_MS + 2000 (32000),
# so the model's own retries can finish. Best left empty: the default follows the
# timeout above. With JARVIS_LLM_TIMEOUT_MS=20000 that is 3 × 20000 + 2000 = 62000.
# A lower value is used as set, with a warning (it cuts slow answers off); a value
# that is not a positive number of milliseconds is not used, also with a warning.

# JARVIS_PLANNING_WATCHDOG_MS=62000

# Background checks: active window, Chrome tabs, JARVIS services (defaults 8000, 12000, 20000).

# JARVIS_ACTIVE_WINDOW_POLL_MS=20000

# JARVIS_CHROME_TABS_POLL_MS=60000

# JARVIS_SERVICES_POLL_MS=60000

# Python services print at once, so the log shows their loading times.

# PYTHONUNBUFFERED=1

# ─── Tests only (pnpm test) ───────────────────────────────────────────────────
# windowsScriptsTest checks JARVIS's PowerShell files with PowerShell 7 (pwsh).
# JARVIS itself keeps running on Windows PowerShell 5.1; this is only for the
# test. Install it in CMD:   winget install --id Microsoft.PowerShell --source winget
# then open a NEW CMD window and check:   pwsh -v
# The test finds pwsh on the PATH or in C:\Program Files\PowerShell\7. Elsewhere,
# name it in the window that runs the tests (the runner does not read it from
# this file), for example in CMD:
#   set JARVIS_TEST_PWSH=D:\Tools\PowerShell\7\pwsh.exe
