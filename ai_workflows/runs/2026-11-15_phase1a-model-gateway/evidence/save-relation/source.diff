+/** Words that name the owner or JARVIS rather than a claim, and words too common to show where a fact came from. */
+const GENERIC = new Set(['user', 'owner', 'me', 'my', 'myself', 'jarvis', 'sir']);
+const COMMON = new Set(['the', 'and', 'for', 'with', 'that', 'this', 'from', 'are', 'was', 'were', 'has', 'have', 'had', 'its', 'you', 'your', 'our', 'not', 'but', 'about', 'into', 'over']);
+const significant = (s: string): string[] => s.toLowerCase().split(/[^a-z0-9]+/)
+  .filter((w) => (w.length >= 3 || /\d/.test(w)) && !COMMON.has(w) && !GENERIC.has(w))
+  .map((w) => (w.length > 3 ? w.replace(/s$/, '') : w));
+
+/**
+ * Why a relation must not be stored (owner, 2026-11-17, L-5; LR2_L5_PLAN.md §10):
+ * unverified information never enters trusted long-term memory. Inside a goal,
+ * its facts come from other agents' results, which are not verified. With a
+ * request in flight, a fact that is not in that request's own words came from
+ * somewhere else (an agent's result, a page, a document). Undefined: it may be
+ * stored. With no request in flight (code calling the registry) nothing changes.
+ */
+export function unverifiedRelation(entity1: string, entity2: string): string | undefined {
+  const goal = getGoalContext();
+  if (goal) {
+    return `inside the goal "${goal.title.slice(0, 80)}" facts come from other agents' results, which are not verified, so nothing was stored `
+      + '(the result stays in the goal\'s record). Say the fact yourself to keep it';
+  }
+  const request = getRequestText();
+  if (request === undefined) return undefined;
+  const said = new Set(significant(request));
+  const unsaid = [entity1, entity2].filter((e) => significant(e).some((w) => !said.has(w)));
+  return unsaid.length
+    ? `"${unsaid.join('" and "')}" is not in the words of this request, so it may come from a result that was not verified; nothing was stored. Say the fact yourself to keep it`
+    : undefined;
+}
 
